generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum UserRole {
  ADMIN
  DIRECTOR
  MANAGER
  LEADER
  EMPLOYEE
}

enum AuditAction {
  login
  logout
  reset_password
  lock_account
  unlock_account
  profile_updated
  avatar_uploaded
  avatar_deleted
  password_changed
  settings_updated
}

enum TaskStatus {
  TO_DO
  IN_PROGRESS
  PENDING
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PendingBlockType {
  RESOURCE
  SKILL
  OTHER
}

enum ExtendRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KpiGrade {
  EXCELLENT
  GOOD
  PASS
  NEEDS_IMPROVEMENT
}

enum AiMessageRole {
  user
  assistant
  system
}
 

model Profile {
  id          String     @id @db.Uuid
  email       String     @unique
  fullName    String?    @map("full_name")
  displayName String?    @map("display_name")
  phone       String?
  avatarUrl   String?    @map("avatar_url")
  avatarUploadedAt DateTime? @map("avatar_uploaded_at") @db.Timestamptz(6)

  role               UserRole   @default(EMPLOYEE)
  status             UserStatus @default(ACTIVE)
  forcePasswordChange Boolean    @default(false) @map("force_password_change")
  departmentId       String?    @map("department_id") @db.Uuid
  teamId             String?    @map("team_id") @db.Uuid

  theme       String     @default("light")
  locale      String     @default("vi-VN")
  timeZone    String     @default("Asia/Ho_Chi_Minh") @map("time_zone")
  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz(6)
  lockedUntil DateTime?  @map("locked_until") @db.Timestamptz(6)

  notificationEmail Boolean @default(true) @map("notification_email")
  keyboardShortcuts String? @map("keyboard_shortcuts")
  defaultTaskFilter String? @map("default_task_filter")

  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  department  Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  team        Team?       @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  managedDepartments Department[] @relation("DepartmentManager")
  leadTeams   Team[]      @relation("TeamLeader")

  auditLogs AuditLog[]
  sessions  UserSession[]
  loginAttempts LoginAttempt[]
  trustedDevices TrustedDevice[]
  notifications Notification[]

  createdTasks       Task[]              @relation("TaskCreator")
  taskAssignments    TaskAssignee[]
  taskComments       TaskComment[]
  taskAttachments    TaskAttachment[]    @relation("AttachmentUploader")
  taskStatusChanges  TaskStatusHistory[]
  extendRequestsMade TaskExtendRequest[] @relation("ExtendRequester")
  extendRequestsReviewed TaskExtendRequest[] @relation("ExtendReviewer")
  reviewedTasks      Task[]              @relation("TaskReviewer")
  kpiRecords         KpiRecord[]
  aiConversations    AiConversation[]    @relation("AiConversationOwner")

  @@index([departmentId], map: "idx_profiles_department_id")
  @@index([teamId], map: "idx_profiles_team_id")
  @@index([role], map: "idx_profiles_role")
  @@index([status], map: "idx_profiles_status")
  @@map("profiles")
}

model AuditLog {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?     @map("actor_user_id") @db.Uuid
  action      AuditAction
  entityType  String      @map("entity_type")
  entityId    String?     @map("entity_id") @db.Uuid
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  actor Profile? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt], map: "idx_audit_logs_actor_user_id_created_at")
  @@index([entityType, entityId], map: "idx_audit_logs_entity_type_entity_id")
  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@map("audit_logs")
}

model TrustedDevice {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  deviceFingerprint String   @map("device_fingerprint")
  deviceName       String?   @map("device_name")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  trustedUntil     DateTime  @map("trusted_until") @db.Timestamptz(6)
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceFingerprint], map: "ux_trusted_devices_user_fingerprint")
  @@index([trustedUntil], map: "idx_trusted_devices_trusted_until")
  @@map("trusted_devices")
}

model LoginAttempt {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String
  userId        String?   @map("user_id") @db.Uuid
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  success       Boolean   @default(false)
  failureReason String?   @map("failure_reason")
  attemptedAt   DateTime  @default(now()) @map("attempted_at") @db.Timestamptz(6)

  user Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, attemptedAt(sort: Desc)], map: "idx_login_attempts_email_attempted_at")
  @@index([userId, attemptedAt(sort: Desc)], map: "idx_login_attempts_user_id_attempted_at")
  @@map("login_attempts")
}

model UserSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  sessionTokenHash String    @unique @map("session_token_hash")
  deviceName       String?   @map("device_name")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  isCurrent        Boolean   @default(false) @map("is_current")
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt(sort: Desc)], map: "idx_user_sessions_user_id_last_seen_at")
  @@index([expiresAt], map: "idx_user_sessions_expires_at")
  @@map("user_sessions")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  payload   Json     @default("{}")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_notifications_user_id_created_at")
  @@index([userId, readAt], map: "idx_notifications_user_id_read_at")
  @@map("notifications")
}

model Department {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  code        String   @unique
  description String?
  managerId   String   @map("manager_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  manager Profile @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: Restrict)
  members Profile[] @relation("DepartmentMembers")
  teams   Team[]
  tasks   Task[]

  @@index([managerId], map: "idx_departments_manager_id")
  @@map("departments")
}

model Team {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  description   String?
  leaderId      String   @map("leader_id") @db.Uuid
  departmentId  String   @map("department_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  leader     Profile @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  members    Profile[] @relation("TeamMembers")

  @@unique([name, departmentId], map: "ux_teams_name_department_id")
  @@index([departmentId], map: "idx_teams_department_id")
  @@index([leaderId], map: "idx_teams_leader_id")
  @@map("teams")
}

model Task {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                String
  description          String?
  status               TaskStatus    @default(TO_DO)
  priority             TaskPriority  @default(NORMAL)
  weight               Int
  deadline             DateTime      @db.Date
  progressPercent      Int           @default(0) @map("progress_percent")
  tags                 String[]      @default([])
  pendingReason        String?       @map("pending_reason")
  pendingBlockType     PendingBlockType? @map("pending_block_type")
  rejectReason         String?       @map("reject_reason")
  urgentOverrideReason String?       @map("urgent_override_reason")
  startedAt            DateTime?     @map("started_at") @db.Timestamptz(6)
  submittedAt          DateTime?     @map("submitted_at") @db.Timestamptz(6)
  reviewSummary        String?       @map("review_summary")
  selfAssessment       Json?         @map("self_assessment")
  qualityScoreRaw      Int?          @map("quality_score_raw")
  qualityScore         Int?          @map("quality_score")
  penaltyDays          Int           @default(0) @map("penalty_days")
  reviewedAt           DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  reviewedById         String?       @map("reviewed_by_id") @db.Uuid
  reviewComment        String?       @map("review_comment")
  reviewRejectReason   String?       @map("review_reject_reason")
  completedAt          DateTime?     @map("completed_at") @db.Timestamptz(6)
  cancelledAt          DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  deletedAt            DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdById          String        @map("created_by_id") @db.Uuid
  departmentId         String        @map("department_id") @db.Uuid
  parentTaskId         String?       @map("parent_task_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator    Profile    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewer   Profile?   @relation("TaskReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  parentTask Task?      @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks   Task[]     @relation("TaskSubtasks")

  assignees      TaskAssignee[]
  comments       TaskComment[]
  attachments    TaskAttachment[]
  checklistItems TaskChecklistItem[]
  statusHistory  TaskStatusHistory[]
  extendRequests TaskExtendRequest[]

  @@index([departmentId, status], map: "idx_tasks_department_status")
  @@index([createdById], map: "idx_tasks_created_by_id")
  @@index([parentTaskId], map: "idx_tasks_parent_task_id")
  @@index([deadline], map: "idx_tasks_deadline")
  @@index([status], map: "idx_tasks_status")
  @@index([deletedAt], map: "idx_tasks_deleted_at")
  @@index([reviewedById], map: "idx_tasks_reviewed_by_id")
  @@map("tasks")
}

model KpiRecord {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  month          Int
  year           Int
  totalScore     Float     @map("total_score")
  grade          KpiGrade
  taskBreakdown  Json      @map("task_breakdown")
  onTimeRate     Float     @map("on_time_rate")
  calculatedAt   DateTime  @default(now()) @map("calculated_at") @db.Timestamptz(6)
  calculatedById String?   @map("calculated_by_id") @db.Uuid

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year], map: "ux_kpi_records_user_month_year")
  @@index([year, month], map: "idx_kpi_records_year_month")
  @@index([userId], map: "idx_kpi_records_user_id")
  @@map("kpi_records")
}

model AiConversation {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  title      String?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      Profile     @relation("AiConversationOwner", fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId, updatedAt(sort: Desc)], map: "idx_ai_conversations_user_id_updated_at")
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  role           AiMessageRole
  content        String
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Asc)], map: "idx_ai_messages_conversation_id_created_at")
  @@map("ai_messages")
}

model TaskAssignee {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  assigneeId String   @map("assignee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee Profile @relation(fields: [assigneeId], references: [id], onDelete: Cascade)

  @@unique([taskId, assigneeId], map: "ux_task_assignees_task_assignee")
  @@index([assigneeId], map: "idx_task_assignees_assignee_id")
  @@map("task_assignees")
}

model TaskComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author Profile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent TaskComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies TaskComment[] @relation("CommentReplies")

  @@index([taskId, createdAt], map: "idx_task_comments_task_id_created_at")
  @@map("task_comments")
}

model TaskAttachment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  fileName     String   @map("file_name")
  fileUrl      String   @map("file_url")
  storagePath  String   @map("storage_path")
  fileSize     Int      @map("file_size")
  mimeType     String   @map("mime_type")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task       Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy Profile @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([taskId], map: "idx_task_attachments_task_id")
  @@map("task_attachments")
}

model TaskChecklistItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  title     String
  isDone    Boolean  @default(false) @map("is_done")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder], map: "idx_task_checklist_task_id_sort")
  @@map("task_checklist_items")
}

model TaskStatusHistory {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId     String      @map("task_id") @db.Uuid
  fromStatus TaskStatus? @map("from_status")
  toStatus   TaskStatus  @map("to_status")
  reason     String?
  actorId    String      @map("actor_id") @db.Uuid
  metadata   Json        @default("{}")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  task  Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor Profile @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt(sort: Desc)], map: "idx_task_status_history_task_created")
  @@map("task_status_history")
}

model TaskExtendRequest {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId           String              @map("task_id") @db.Uuid
  requestedById    String              @map("requested_by_id") @db.Uuid
  proposedDeadline DateTime            @map("proposed_deadline") @db.Date
  reason           String
  status           ExtendRequestStatus @default(PENDING)
  reviewedById     String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt       DateTime?           @map("reviewed_at") @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy Profile  @relation("ExtendRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy  Profile? @relation("ExtendReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([taskId, status], map: "idx_task_extend_requests_task_status")
  @@map("task_extend_requests")
}
