generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  inactive
  locked
  disabled
}

enum AuditAction {
  login
  logout
  reset_password
}

model Profile {
  id          String     @id @db.Uuid
  email       String     @unique
  fullName    String?    @map("full_name")
  status      UserStatus @default(active)
  locale      String     @default("vi-VN")
  timeZone    String     @default("Asia/Ho_Chi_Minh") @map("time_zone")
  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  auditLogs AuditLog[]

  @@map("profiles")
}

model AuditLog {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?     @map("actor_user_id") @db.Uuid
  action      AuditAction
  entityType  String      @map("entity_type")
  entityId    String?     @map("entity_id") @db.Uuid
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  actor Profile? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt], map: "idx_audit_logs_actor_user_id_created_at")
  @@index([entityType, entityId], map: "idx_audit_logs_entity_type_entity_id")
  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@map("audit_logs")
}
